# Environment variables for Smart Food Court & Queue Management System
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-foodcourt-smart-2026-secure-random

# Database configuration
# The app defaults to data/smart_food_court.sqlite3.
# Optional override. By default the app uses data/smart_food_court.sqlite3.
# DATABASE_URL=sqlite:///D:/newfoodcourt/data/smart_food_court.sqlite3
