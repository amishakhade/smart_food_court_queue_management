# Environment variables for Smart Food Court & Queue Management System
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-foodcourt-smart-2026-secure-random

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=foodcourt_user
MYSQL_PASSWORD=foodcourt_pass123
MYSQL_DB=smart_food_court

# Default Database URI (PyMySQL driver)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://foodcourt_user:foodcourt_pass123@localhost:3306/smart_food_court
